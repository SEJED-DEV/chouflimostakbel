# Copy to `.env.local` and fill in. Never commit the real file.
#
# Every variable here is optional. Without them the site still builds, runs and
# works - the contact form is the only thing that needs them, and it says so
# plainly rather than pretending a message was sent.

# ---- Contact form -------------------------------------------------------
# The form posts to /api/contact. With no key below that endpoint answers 503
# and the page shows contact@chouflimostakbel.tn instead of a form that would
# quietly swallow the message.

# Transactional email provider (Resend).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A sender address on a domain you have verified with the provider. Resend's
# onboarding address works while you are setting the domain up.
# CONTACT_FROM_EMAIL=Choufli Mosta9bel <hello@chouflimostakbel.tn>

# Where messages land. Defaults to contact@chouflimostakbel.tn.
# CONTACT_TO_EMAIL=contact@chouflimostakbel.tn

# ---- Deploy status ------------------------------------------------------
# /api/status compares this build against GitHub so the changelog can say
# whether it is current. Unauthenticated it is limited to 60 requests an hour
# per server address; the response is cached at the edge for ten minutes, so a
# token is not required. Set one if you hit the limit or go private.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Update notifications ----------------------------------------------
# Generate a key pair with: npm run vapid
#
# The public key is published to the browser and is safe to see. The private
# key is not: back it up. Changing it invalidates every existing subscription,
# so every reader would have to turn notifications on again.

# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl6...

# VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Who the notifications are from. Some push services insist on a contact.
# VAPID_SUBJECT=mailto:contact@chouflimostakbel.tn

# Shared secret for POST /api/push/send. Without it the route refuses to run.
# PUSH_SEND_SECRET=pick-a-long-random-string

# ---- Database -----------------------------------------------------------
# Where push subscriptions are stored. Point it at the self-hosted Supabase
# Postgres. With no DATABASE_URL they go to data/push.json instead, which is
# fine for one machine but is not a backup.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/chouflimostakbel
